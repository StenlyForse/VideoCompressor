<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VideoCompressor.App.ViewModels"
        x:Class="VideoCompressor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Video Compressor"
        Width="660"
        SizeToContent="Height"
        MinWidth="560"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <StackPanel Margin="20" Spacing="16">

        <!-- FR-006: FFmpeg is not installed -->
        <Border Classes="banner" IsVisible="{Binding IsFfmpegMissing}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding FfmpegHintMessage}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding FfmpegHintCommand}" FontFamily="Consolas,Menlo,monospace" />
            </StackPanel>
        </Border>

        <!-- US-1.1: source video, also the drop target -->
        <Border x:Name="DropZone" Classes="dropZone">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Перетащите видео сюда"
                               Classes="secondary"
                               IsVisible="{Binding !HasVideo}" />
                    <TextBlock Text="{Binding FileName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding HasVideo}" />
                    <TextBlock Text="{Binding VideoSummary}"
                               Classes="secondary"
                               IsVisible="{Binding HasVideo}" />
                    <TextBlock Classes="warning"
                               TextWrapping="Wrap"
                               Text="HDR-видео: в этой версии HDR не поддерживается, цвета в результате могут выглядеть блёклыми."
                               IsVisible="{Binding IsHdr}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Content="Выбрать файл…"
                        Command="{Binding BrowseInputCommand}" />
            </Grid>
        </Border>

        <!-- Settings; locked while compressing -->
        <Grid ColumnDefinitions="140,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="6"
              IsEnabled="{Binding IsIdle}">

            <!-- US-2: level + percent slider -->
            <TextBlock Grid.Row="0" Text="Степень сжатия" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      MinWidth="260"
                      ItemsSource="{Binding Levels}"
                      SelectedItem="{Binding SelectedLevel}"
                      PlaceholderText="Своя настройка">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LevelOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Classes="secondary"
                       TextWrapping="Wrap"
                       Text="{Binding LevelDescription}" />
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="0%" Classes="secondary" VerticalAlignment="Center" />
                <Slider Grid.Column="1"
                        Minimum="0" Maximum="100"
                        SmallChange="1" LargeChange="5"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CompressionPercent}" />
                <TextBlock Grid.Column="2" Text="100%" Classes="secondary" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           MinWidth="44"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding CompressionPercent, StringFormat={}{0}%}" />
            </Grid>

            <!-- US-4: output format and encoder -->
            <TextBlock Grid.Row="3" Text="Формат" VerticalAlignment="Center" Margin="0,10,0,0" />
            <ComboBox Grid.Row="3" Grid.Column="1"
                      Margin="0,10,0,0"
                      MinWidth="260"
                      ItemsSource="{Binding Formats}"
                      SelectedItem="{Binding SelectedFormat}"
                      DisplayMemberBinding="{ReflectionBinding Name}" />
            <TextBlock Grid.Row="4" Grid.Column="1"
                       Classes="secondary"
                       TextWrapping="Wrap"
                       Text="{Binding SelectedFormat.Hint}" />

            <TextBlock Grid.Row="5" Text="Кодировщик" VerticalAlignment="Center" Margin="0,10,0,0" />
            <ComboBox Grid.Row="5" Grid.Column="1"
                      Margin="0,10,0,0"
                      MinWidth="260"
                      ItemsSource="{Binding Encoders}"
                      SelectedItem="{Binding SelectedEncoder}"
                      DisplayMemberBinding="{ReflectionBinding Name}" />
            <TextBlock Grid.Row="6" Grid.Column="1"
                       Classes="secondary"
                       TextWrapping="Wrap"
                       Text="{Binding SelectedEncoder.Hint}" />

            <!-- US-3: optional, collapsed by default -->
            <Expander Grid.Row="7" Grid.ColumnSpan="2"
                      Margin="0,10,0,0"
                      HorizontalAlignment="Stretch"
                      Header="{Binding AdvancedHeader}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Text="Разрешение" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  MinWidth="130"
                                  ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding SelectedResolution}"
                                  DisplayMemberBinding="{ReflectionBinding Name}" />
                        <TextBlock Grid.Column="2" Text="Частота кадров" Margin="14,0,0,0" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="3"
                                  MinWidth="130"
                                  ItemsSource="{Binding FrameRates}"
                                  SelectedItem="{Binding SelectedFrameRate}"
                                  DisplayMemberBinding="{ReflectionBinding Name}" />
                    </Grid>
                    <TextBlock Classes="secondary"
                               TextWrapping="Wrap"
                               Text="Видео только уменьшается: если исходник меньше выбранного значения, оно не меняется. Пропорции кадра сохраняются." />
                </StackPanel>
            </Expander>
        </Grid>

        <!-- US-5: where to save -->
        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" IsVisible="{Binding HasVideo}">
            <TextBlock Text="Сохранить в" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     IsReadOnly="True"
                     Text="{Binding OutputPath}"
                     ToolTip.Tip="{Binding OutputPath}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="…"
                    ToolTip.Tip="Выбрать, куда сохранить"
                    Command="{Binding BrowseOutputCommand}" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Classes="error"
                       TextWrapping="Wrap"
                       Text="{Binding OutputError}"
                       IsVisible="{Binding HasOutputError}" />
        </Grid>

        <Separator />

        <!-- US-1.2, US-1.3: progress and result -->
        <StackPanel Spacing="8">
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent}"
                         IsVisible="{Binding IsBusy}" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding StatusText}"
                           Classes.error="{Binding HasError}" />
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Content="Показать файл"
                        Command="{Binding RevealOutputCommand}"
                        IsVisible="{Binding HasResult}" />
            </Grid>
            <Expander Header="Подробности ошибки"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding HasErrorDetails}">
                <SelectableTextBlock Text="{Binding ErrorDetails}"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas,Menlo,monospace"
                                     FontSize="12" />
            </Expander>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Отмена"
                    MinWidth="100"
                    HorizontalContentAlignment="Center"
                    Command="{Binding CompressCancelCommand}"
                    IsVisible="{Binding IsBusy}" />
            <Button Content="Сжать"
                    Classes="accent"
                    MinWidth="100"
                    HorizontalContentAlignment="Center"
                    Command="{Binding CompressCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
